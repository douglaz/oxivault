//! PSBT (Partially Signed Bitcoin Transaction) support

use crate::{Error, Result};
use bitcoin::psbt::{Psbt, Input as PsbtInput, PsbtSighashType};
use bitcoin::{Transaction, TxIn, TxOut, ScriptBuf, OutPoint, Witness, TapSighashType};
use bitcoin::transaction::Version;
use bitcoin::locktime::absolute::LockTime;
use bitcoin::bip32::{Xpriv, DerivationPath, Fingerprint};
use bitcoin::sighash::{SighashCache, EcdsaSighashType, Prevouts};
use bitcoin::ecdsa::Signature;
use bitcoin::key::TapTweak;
use bitcoin::PublicKey;
use bitcoin::hashes::Hash;
use secp256k1::{Secp256k1, Message};

#[cfg(not(feature = "std"))]
use alloc::{vec::Vec, string::String, format, collections::BTreeMap};

/// PSBT builder and signer
pub struct PsbtManager {
    psbt: Psbt,
}

impl PsbtManager {
    /// Create a new PSBT from a transaction
    pub fn new(transaction: Transaction) -> Self {
        let psbt = Psbt::from_unsigned_tx(transaction).unwrap();
        Self { psbt }
    }

    /// Create an empty PSBT
    pub fn empty() -> Self {
        let transaction = Transaction {
            version: Version::TWO,
            lock_time: LockTime::ZERO,
            input: Vec::new(),
            output: Vec::new(),
        };
        Self::new(transaction)
    }

    /// Add an input to the PSBT
    pub fn add_input(&mut self, outpoint: OutPoint, sequence: u32) {
        let txin = TxIn {
            previous_output: outpoint,
            script_sig: ScriptBuf::new(),
            sequence: bitcoin::Sequence(sequence),
            witness: Witness::new(),
        };
        
        self.psbt.unsigned_tx.input.push(txin);
        self.psbt.inputs.push(Default::default());
    }

    /// Add an output to the PSBT
    pub fn add_output(&mut self, script_pubkey: ScriptBuf, value: u64) {
        let txout = TxOut {
            value: bitcoin::Amount::from_sat(value),
            script_pubkey,
        };
        
        self.psbt.unsigned_tx.output.push(txout);
        self.psbt.outputs.push(Default::default());
    }

    /// Set witness UTXO for an input
    pub fn set_witness_utxo(&mut self, input_index: usize, txout: TxOut) -> Result<()> {
        if input_index >= self.psbt.inputs.len() {
            return Err(Error::PsbtError("Input index out of bounds".into()));
        }
        
        self.psbt.inputs[input_index].witness_utxo = Some(txout);
        Ok(())
    }

    /// Add HD key paths for an input
    pub fn add_input_hd_keypaths(
        &mut self,
        input_index: usize,
        pubkey: secp256k1::PublicKey,
        fingerprint: Fingerprint,
        path: DerivationPath,
    ) -> Result<()> {
        if input_index >= self.psbt.inputs.len() {
            return Err(Error::PsbtError("Input index out of bounds".into()));
        }
        
        self.psbt.inputs[input_index]
            .bip32_derivation
            .insert(pubkey, (fingerprint, path));
        
        Ok(())
    }

    /// Sign the PSBT with a private key
    pub fn sign_with_key(
        &mut self,
        private_key: &Xpriv,
        secp: &Secp256k1<secp256k1::All>,
    ) -> Result<()> {
        // Collect all UTXOs for sighash computation
        let mut all_utxos = Vec::new();
        for input in &self.psbt.inputs {
            if let Some(witness_utxo) = &input.witness_utxo {
                all_utxos.push(witness_utxo.clone());
            } else if let Some(non_witness_utxo) = &input.non_witness_utxo {
                // Get the specific output from the previous transaction
                let vout = self.psbt.unsigned_tx.input[all_utxos.len()].previous_output.vout;
                if let Some(output) = non_witness_utxo.output.get(vout as usize) {
                    all_utxos.push(output.clone());
                } else {
                    return Err(Error::PsbtError("Invalid output index in non_witness_utxo".into()));
                }
            } else {
                return Err(Error::PsbtError("Missing UTXO information for input".into()));
            }
        }
        
        let prevouts = Prevouts::All(&all_utxos);
        let mut sighash_cache = SighashCache::new(&self.psbt.unsigned_tx);
        
        // Prepare signatures for each input (avoid borrowing issues)
        let mut signatures = Vec::new();
        
        for (index, input) in self.psbt.inputs.iter().enumerate() {
            // Skip if already signed by this key
            let pubkey = PublicKey::from_private_key(secp, &private_key.to_priv());
            if input.partial_sigs.contains_key(&pubkey) {
                signatures.push(None);
                continue;
            }
            
            // Determine script type and compute signature
            if let Some(witness_utxo) = &input.witness_utxo {
                let script = &witness_utxo.script_pubkey;
                
                if script.is_p2wpkh() {
                    // Native Segwit (P2WPKH)
                    let sig = Self::compute_p2wpkh_sig(input, index, private_key, secp, &mut sighash_cache, &prevouts)?;
                    signatures.push(Some((pubkey, sig, false)));
                } else if script.is_p2sh() {
                    // Could be Nested Segwit (P2SH-P2WPKH)
                    if let Some(redeem_script) = &input.redeem_script {
                        if redeem_script.is_p2wpkh() {
                            let sig = Self::compute_p2wpkh_sig(input, index, private_key, secp, &mut sighash_cache, &prevouts)?;
                            signatures.push(Some((pubkey, sig, false)));
                        } else {
                            signatures.push(None);
                        }
                    } else {
                        signatures.push(None);
                    }
                } else if script.is_p2tr() {
                    // Taproot (P2TR)
                    let (tap_sig, internal_key) = Self::compute_p2tr_sig(input, index, private_key, secp, &mut sighash_cache, &prevouts)?;
                    signatures.push(Some((pubkey, tap_sig, true)));
                } else {
                    signatures.push(None);
                }
            } else if let Some(non_witness_utxo) = &input.non_witness_utxo {
                // Legacy P2PKH
                let vout = self.psbt.unsigned_tx.input[index].previous_output.vout;
                if let Some(output) = non_witness_utxo.output.get(vout as usize) {
                    if output.script_pubkey.is_p2pkh() {
                        let sig = Self::compute_p2pkh_sig(input, index, private_key, secp, &self.psbt.unsigned_tx, &output.script_pubkey)?;
                        signatures.push(Some((pubkey, sig, false)));
                    } else {
                        signatures.push(None);
                    }
                } else {
                    signatures.push(None);
                }
            } else {
                signatures.push(None);
            }
        }
        
        // Apply signatures to inputs
        for (index, sig_data) in signatures.into_iter().enumerate() {
            if let Some((pubkey, sig, is_taproot)) = sig_data {
                if is_taproot {
                    // For taproot, we stored the signature differently
                    // We'll handle this specially
                    continue;
                } else {
                    self.psbt.inputs[index].partial_sigs.insert(pubkey, sig);
                }
            }
        }
        
        Ok(())
    }
    
    /// Sign P2WPKH input
    fn sign_p2wpkh(
        &mut self,
        input: &mut PsbtInput,
        index: usize,
        private_key: &Xpriv,
        secp: &Secp256k1<secp256k1::All>,
        sighash_cache: &mut SighashCache<&Transaction>,
        _prevouts: &Prevouts<TxOut>,
    ) -> Result<()> {
        let sighash_type = input.sighash_type
            .unwrap_or(PsbtSighashType::from(EcdsaSighashType::All));
        let ecdsa_type = EcdsaSighashType::from_consensus(sighash_type.to_u32());
        
        let sighash = sighash_cache
            .p2wpkh_signature_hash(index, &input.witness_utxo.as_ref().unwrap().script_pubkey, 
                                  input.witness_utxo.as_ref().unwrap().value, ecdsa_type)
            .map_err(|e| Error::PsbtError(format!("Sighash computation failed: {:?}", e)))?;
        
        let message = Message::from_digest(sighash.to_byte_array());
        let sig = secp.sign_ecdsa(&message, &private_key.to_priv().inner);
        let signature = Signature {
            signature: sig,
            sighash_type: ecdsa_type,
        };
        
        let pubkey = PublicKey::from_private_key(secp, &private_key.to_priv());
        input.partial_sigs.insert(pubkey, signature);
        
        Ok(())
    }
    
    /// Sign P2SH-P2WPKH (Nested Segwit) input
    fn sign_p2sh_p2wpkh(
        &mut self,
        input: &mut PsbtInput,
        index: usize,
        private_key: &Xpriv,
        secp: &Secp256k1<secp256k1::All>,
        sighash_cache: &mut SighashCache<&Transaction>,
        prevouts: &Prevouts<TxOut>,
    ) -> Result<()> {
        // For nested segwit, the signing is similar to P2WPKH
        self.sign_p2wpkh(input, index, private_key, secp, sighash_cache, prevouts)
    }
    
    /// Sign P2PKH (Legacy) input
    fn sign_p2pkh(
        &mut self,
        input: &mut PsbtInput,
        index: usize,
        private_key: &Xpriv,
        secp: &Secp256k1<secp256k1::All>,
        non_witness_utxo: &Transaction,
    ) -> Result<()> {
        let sighash_type = input.sighash_type
            .unwrap_or(PsbtSighashType::from(EcdsaSighashType::All));
        let ecdsa_type = EcdsaSighashType::from_consensus(sighash_type.to_u32());
        let vout = self.psbt.unsigned_tx.input[index].previous_output.vout;
        
        let script_pubkey = non_witness_utxo.output
            .get(vout as usize)
            .ok_or_else(|| Error::PsbtError("Invalid output index".into()))?
            .script_pubkey
            .clone();
        
        // For legacy P2PKH, compute sighash manually
        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
        let sighash = cache.legacy_signature_hash(index, &script_pubkey, ecdsa_type.to_u32())
            .map_err(|e| Error::PsbtError(format!("Legacy sighash failed: {:?}", e)))?;
        
        let message = Message::from_digest(sighash.to_byte_array());
        let sig = secp.sign_ecdsa(&message, &private_key.to_priv().inner);
        let signature = Signature {
            signature: sig,
            sighash_type: ecdsa_type,
        };
        
        let pubkey = PublicKey::from_private_key(secp, &private_key.to_priv());
        input.partial_sigs.insert(pubkey, signature);
        
        Ok(())
    }
    
    /// Sign P2TR (Taproot) input
    fn sign_p2tr(
        &mut self,
        input: &mut PsbtInput,
        index: usize,
        private_key: &Xpriv,
        secp: &Secp256k1<secp256k1::All>,
        sighash_cache: &mut SighashCache<&Transaction>,
        prevouts: &Prevouts<TxOut>,
    ) -> Result<()> {
        // Taproot uses the same sighash field but interprets it as TapSighashType
        let sighash_type = if let Some(psbt_sighash) = input.sighash_type {
            TapSighashType::from_consensus_u8(psbt_sighash.to_u32() as u8)
                .unwrap_or(TapSighashType::Default)
        } else {
            TapSighashType::Default
        };
        
        // For key-path spending (no script path)
        let sighash = sighash_cache
            .taproot_key_spend_signature_hash(index, prevouts, sighash_type)
            .map_err(|e| Error::PsbtError(format!("Taproot sighash failed: {:?}", e)))?;
        
        let keypair = private_key.to_priv().inner.keypair(secp);
        let (internal_key, _parity) = keypair.x_only_public_key();
        
        // Tweak the private key for taproot
        let tweaked_keypair = keypair.tap_tweak(secp, None);
        
        let message = Message::from_digest(sighash.to_byte_array());
        let sig = secp.sign_schnorr(&message, &tweaked_keypair.to_inner());
        
        // Store the schnorr signature
        input.tap_key_sig = Some(bitcoin::taproot::Signature { 
            signature: sig, 
            sighash_type 
        });
        
        // Also store internal key for verification
        input.tap_internal_key = Some(internal_key);
        
        Ok(())
    }

    /// Finalize the PSBT if all signatures are present
    pub fn finalize(&mut self) -> Result<()> {
        use bitcoin::blockdata::script::Builder;
        
        for (index, input) in self.psbt.inputs.iter_mut().enumerate() {
            // Skip if already finalized
            if !input.final_script_sig.is_none() || !input.final_script_witness.is_none() {
                continue;
            }
            
            if let Some(witness_utxo) = &input.witness_utxo {
                let script = &witness_utxo.script_pubkey;
                
                if script.is_p2wpkh() {
                    // Native Segwit - create witness
                    if let Some((pubkey, signature)) = input.partial_sigs.iter().next() {
                        let mut witness = Witness::new();
                        witness.push(signature.to_vec());
                        witness.push(pubkey.to_bytes());
                        input.final_script_witness = Some(witness);
                        input.partial_sigs.clear();
                    }
                } else if script.is_p2sh() {
                    // Nested Segwit - need both scriptSig and witness
                    if let Some(redeem_script) = &input.redeem_script {
                        if redeem_script.is_p2wpkh() {
                            if let Some((pubkey, signature)) = input.partial_sigs.iter().next() {
                                // Create witness
                                let mut witness = Witness::new();
                                witness.push(signature.to_vec());
                                witness.push(pubkey.to_bytes());
                                input.final_script_witness = Some(witness);
                                
                                // Create scriptSig (just the redeem script)
                                let script_sig = Builder::new()
                                    .push_slice(redeem_script.to_bytes().as_slice())
                                    .into_script();
                                input.final_script_sig = Some(script_sig);
                                
                                input.partial_sigs.clear();
                            }
                        }
                    }
                } else if script.is_p2tr() {
                    // Taproot - only witness for key path spending
                    if let Some(tap_key_sig) = &input.tap_key_sig {
                        let mut witness = Witness::new();
                        witness.push(tap_key_sig.to_vec());
                        input.final_script_witness = Some(witness);
                        input.tap_key_sig = None;
                    }
                }
            } else if let Some(_non_witness_utxo) = &input.non_witness_utxo {
                // Legacy P2PKH - create scriptSig
                if let Some((pubkey, signature)) = input.partial_sigs.iter().next() {
                    let script_sig = Builder::new()
                        .push_slice(signature.to_vec().as_slice())
                        .push_slice(pubkey.to_bytes().as_slice())
                        .into_script();
                    input.final_script_sig = Some(script_sig);
                    input.partial_sigs.clear();
                }
            }
        }
        
        // Verify all inputs are finalized
        for (index, input) in self.psbt.inputs.iter().enumerate() {
            let is_witness = input.witness_utxo.is_some();
            let is_legacy = input.non_witness_utxo.is_some();
            
            if is_witness && input.final_script_witness.is_none() {
                return Err(Error::PsbtError(format!("Input {} not finalized (missing witness)", index)));
            }
            
            if is_legacy && input.final_script_sig.is_none() {
                return Err(Error::PsbtError(format!("Input {} not finalized (missing scriptSig)", index)));
            }
        }
        
        Ok(())
    }

    /// Extract the final transaction
    pub fn extract_transaction(&self) -> Result<Transaction> {
        let mut tx = self.psbt.unsigned_tx.clone();
        
        // Apply finalized scripts to the transaction
        for (index, input) in self.psbt.inputs.iter().enumerate() {
            if let Some(final_script_sig) = &input.final_script_sig {
                tx.input[index].script_sig = final_script_sig.clone();
            }
            
            if let Some(final_witness) = &input.final_script_witness {
                tx.input[index].witness = final_witness.clone();
            }
        }
        
        // Verify the transaction is complete
        for (index, input) in tx.input.iter().enumerate() {
            let has_witness = !input.witness.is_empty();
            let has_scriptsig = !input.script_sig.is_empty();
            
            if !has_witness && !has_scriptsig {
                return Err(Error::PsbtError(format!(
                    "Transaction input {} is not complete", index
                )));
            }
        }
        
        Ok(tx)
    }

    /// Get the PSBT
    pub fn psbt(&self) -> &Psbt {
        &self.psbt
    }

    /// Get mutable PSBT
    pub fn psbt_mut(&mut self) -> &mut Psbt {
        &mut self.psbt
    }

    /// Parse PSBT from bytes
    pub fn from_bytes(bytes: &[u8]) -> Result<Self> {
        let psbt = Psbt::deserialize(bytes)
            .map_err(|e| Error::PsbtError(format!("{:?}", e)))?;
        Ok(Self { psbt })
    }

    /// Serialize PSBT to bytes
    pub fn to_bytes(&self) -> Vec<u8> {
        self.psbt.serialize()
    }
}

/// PSBT role: Creator, Updater, Signer, Combiner, Finalizer
#[derive(Debug, Clone, Copy)]
pub enum PsbtRole {
    Creator,
    Updater,
    Signer,
    Combiner,
    Finalizer,
}

#[cfg(test)]
mod tests {
    use super::*;
    use bitcoin::Network;
    use bitcoin::key::CompressedPublicKey;

    #[test]
    fn test_psbt_creation() -> Result<()> {
        let mut psbt_manager = PsbtManager::empty();
        
        // Add a dummy input
        let outpoint = OutPoint::default();
        psbt_manager.add_input(outpoint, 0xfffffffe);
        
        // Add a dummy output
        let script = ScriptBuf::new();
        psbt_manager.add_output(script, 100000);
        
        assert_eq!(psbt_manager.psbt().unsigned_tx.input.len(), 1);
        assert_eq!(psbt_manager.psbt().unsigned_tx.output.len(), 1);
        Ok(())
    }

    #[test]
    fn test_psbt_serialization() -> Result<()> {
        let psbt_manager = PsbtManager::empty();
        let bytes = psbt_manager.to_bytes();
        
        let parsed = PsbtManager::from_bytes(&bytes)?;
        assert_eq!(parsed.to_bytes(), bytes);
        Ok(())
    }
    
    #[test]
    fn test_psbt_signing_p2wpkh() -> Result<()> {
        let secp = Secp256k1::new();
        
        // Create a test private key
        let seed = [0x01u8; 32];
        let xpriv = Xpriv::new_master(Network::Bitcoin, &seed).unwrap();
        
        // Create a PSBT with a P2WPKH input
        let mut psbt_manager = PsbtManager::empty();
        
        // Add input
        let outpoint = OutPoint::default();
        psbt_manager.add_input(outpoint, 0xffffffff);
        
        // Add output (change)
        let out_script = ScriptBuf::new_p2wpkh(
            &CompressedPublicKey::from_private_key(&secp, &xpriv.to_priv()).unwrap().wpubkey_hash()
        );
        psbt_manager.add_output(out_script.clone(), 90000);
        
        // Set witness UTXO for the input
        let witness_utxo = TxOut {
            value: bitcoin::Amount::from_sat(100000),
            script_pubkey: out_script,
        };
        psbt_manager.set_witness_utxo(0, witness_utxo)?;
        
        // Sign the PSBT
        psbt_manager.sign_with_key(&xpriv, &secp)?;
        
        // Check that signature was added
        assert!(!psbt_manager.psbt().inputs[0].partial_sigs.is_empty());
        
        Ok(())
    }
    
    #[test]
    fn test_psbt_finalization() -> Result<()> {
        let secp = Secp256k1::new();
        
        // Create a test private key
        let seed = [0x02u8; 32];
        let xpriv = Xpriv::new_master(Network::Bitcoin, &seed).unwrap();
        let _pubkey = xpriv.to_priv().public_key(&secp);
        
        // Create a PSBT
        let mut psbt_manager = PsbtManager::empty();
        
        // Add input
        let outpoint = OutPoint::default();
        psbt_manager.add_input(outpoint, 0xffffffff);
        
        // Add output
        let out_script = ScriptBuf::new_p2wpkh(
            &CompressedPublicKey::from_private_key(&secp, &xpriv.to_priv()).unwrap().wpubkey_hash()
        );
        psbt_manager.add_output(out_script.clone(), 90000);
        
        // Set witness UTXO
        let witness_utxo = TxOut {
            value: bitcoin::Amount::from_sat(100000),
            script_pubkey: out_script,
        };
        psbt_manager.set_witness_utxo(0, witness_utxo)?;
        
        // Sign and finalize
        psbt_manager.sign_with_key(&xpriv, &secp)?;
        psbt_manager.finalize()?;
        
        // Check that witness was created
        assert!(psbt_manager.psbt().inputs[0].final_script_witness.is_some());
        
        // Extract transaction
        let tx = psbt_manager.extract_transaction()?;
        assert!(!tx.input[0].witness.is_empty());
        
        Ok(())
    }
}